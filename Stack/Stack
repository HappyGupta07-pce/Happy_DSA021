import java.util.*;
class Stack{
    int top;
    int []arr;
    int size;
    Stack(int s){
    top = -1;
    size = 5;
    arr = new int[s] ;
    }
    void push(int v){
    if(top == size -1){
        System.out.println("Overflow");
    }    
    else{
        top = top + 1;
        arr[top] = v ;
    }
    }
    int pop(){
    if(top == -1){
        System.out.println("Underflow");
        return 0;
    }
    else{
        int ele = arr[top];
        top = top - 1;
        return ele ;
    }
    }
    void display(){
        for(int i = 0; i <= top;i++){
            System.out.println(arr[i]);
        }
    }
}
 public class Main {
    public static void main (String[] args) {
        Stack s = new Stack(10);
        s.push(1);
        s.push(2);
        s.push(3);
        s.display();
        s.pop();
        s.display();
        return ;
    }
}